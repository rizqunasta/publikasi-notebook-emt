>function fx(a,c,d) &= rhs(s1[1]); $fx(a,c,d), function fy(a,c,d) &= rhs(s1[2]); $fy(a,c,d)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-046.png
% // latex: 0
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-047.png
% // latex: 0
% Sekarang kita dapat menggambar himpunan itu. Sisi b bervariasi dari 1 sampai 4.
% Sudah diketahui bahwa kita mendapatkan elips.
>aspect(1); plot2d(&fx(3,x,5),&fy(3,x,5),xmin=1,xmax=4,square=1):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-048.png
% Kita dapat memeriksa persamaan umum elips ini, yaitu
% 
% latex: \frac{(x-x_m)^2}{u^2}+\frac{(y-y_m)}{v^2}=1,
% 
% dengan (xm,ym) adalah pusat, dan u dan v adalah sumbu-sumbu setengah.
>$ratsimp((fx(a,c,d)-a/2)^2/u^2+fy(a,c,d)^2/v^2 with [u=d/2,v=sqrt(d^2-a^2)/2])
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-049.png
% // latex: \frac{a^2}{d^2}
% Kita lihat bahwa tinggi dan dengan demikian luas segitiga maksimal
% untuk x=0. Jadi luas segitiga dengan a+b+c=d maksimal jika segitiga
% itu sama sisi. Kita ingin menurunkan hal ini secara analitik.
>eqns &= [diff(H(a,b,d-(a+b))^2,a)=0,diff(H(a,b,d-(a+b))^2,b)=0]; $eqns
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-050.png
% // latex: \left[ \frac{a\,{\it ysol}^2}{2}=0 , 0=0 \right] 
% Kita mendapatkan beberapa minimum, yang berkaitan dengan segitiga dengan satu sisi 0, dan
% solusi a=b=c=d/3.
>$solve(eqns,[a,b])
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-051.png
% // latex: \left[ \left[ a=0 , b={\it \%r_1} \right]  \right] 
% Ada juga metode Lagrange, memaksimumkan H(a,b,c)^2 terhadap a+b+c=d.
>&solve([diff(H(a,b,c)^2,a)=la,diff(H(a,b,c)^2,b)=la, ...
>   diff(H(a,b,c)^2,c)=la,a+b+c=d],[a,b,c,la])
