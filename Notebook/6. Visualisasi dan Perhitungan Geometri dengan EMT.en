% Dengan geometri, kita turunkan rumus sederhana
% 
% latex: \frac{a}{\sin(\alpha)}=2r
% 
% untuk jari-jari tersebut. Kita bisa memeriksa, apakah ini benar dengan Maxima. Maxima hanya akan
% memfaktorkannya jika kita kuadratkan.
>$c^2/sin(computeAngle(A,B,C))^2  | factor
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-055.png
% // latex: \left[ \frac{{\it a_2}^2+{\it a_1}^2}{{\it a_2}^2} , 0 , \frac{16\,  \left({\it a_2}^2+{\it a_1}^2\right)}{{\it a_2}^2} \right] 
% 
% * Contoh 4: Garis Euler dan Parabola
% 
% ** Uraian Materi
% 
% Garis Euler: pada setiap segitiga yang tidak sama sisi, titik tinggi H, titik berat G, dan
% pusat lingkaran luar O terletak segaris, dan GH = 2 GO (G membagi OH dengan perbandingan 1 : 2).
% Pada garis ini juga terletak pusat lingkaran sembilan titik dan titik Exeter. Pada segitiga
% sama sisi keempat titik berimpit sehingga garis Euler tidak terdefinisi.
% 
% Parabola: tempat kedudukan titik-titik yang berjarak sama ke satu titik tetap (fokus) dan ke
% satu garis tetap (direktriks). Pada contoh ini fokusnya C dan direktriksnya garis AB, sehingga
% persamaannya: (jarak titik ke garis AB) = (jarak titik ke C). Karena direktriksnya miring,
% parabolanya terputar (sumbunya tegak lurus AB).
% 
% ** Penyelesaian dengan EMT
% 
% Garis Euler adalah garis yang ditentukan dari sebarang segitiga yang tidak sama sisi. Garis ini
% merupakan garis pusat segitiga, yang melalui beberapa titik penting yang ditentukan dari
% segitiga itu, termasuk titik tinggi, pusat lingkaran luar, titik berat, titik Exeter, dan
% pusat lingkaran sembilan titik segitiga tersebut.
% 
% Untuk demonstrasi, kita hitung dan gambar garis Euler pada suatu segitiga.
% 
% Pertama, kita definisikan titik-titik sudut segitiga di Euler. Kita memakai definisi yang
% terlihat dalam ekspresi simbolik.
>A::=[-1,-1]; B::=[2,0]; C::=[1,2];
% Untuk menggambar objek geometri, kita siapkan bidang gambar, dan tambahkan titik-titik ke
% dalamnya. Semua gambar objek geometri ditambahkan ke gambar yang sedang aktif.
>setPlotRange(3); plotPoint(A,"A"); plotPoint(B,"B"); plotPoint(C,"C");
% Kita juga dapat menambahkan sisi-sisi segitiga.
>plotSegment(A,B,""); plotSegment(B,C,""); plotSegment(C,A,""):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-056.png
% Berikut luas segitiga, dengan rumus determinan. Tentu saja, kita harus mengambil nilai
% mutlak hasil ini.
>$areaTriangle(A,B,C)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-057.png
% // latex: -\frac{7}{2}
% Kita dapat menghitung koefisien sisi c.
>c &= lineThrough(A,B)

                            [- 1, 3, - 2]

% Dan juga mendapatkan rumus untuk garis ini.
>$getLineEquation(c,x,y)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-058.png
% // latex: 3\,y-x=-2
% Untuk bentuk Hesse, kita perlu menentukan suatu titik, sehingga titik tersebut berada pada sisi
% positif bentuk Hesse. Memasukkan titik tersebut menghasilkan jarak positif ke garis.
>$getHesseForm(c,x,y,C), $at(%,[x=C[1],y=C[2]])
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-059.png
% // latex: \frac{3\,y-x+2}{\sqrt{10}}
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-060.png
% // latex: \frac{7}{\sqrt{10}}
% Sekarang kita hitung lingkaran luar ABC.
>LL &= circleThrough(A,B,C); $getCircleEquation(LL,x,y)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-061.png
% // latex: \left(y-\frac{5}{14}\right)^2+\left(x-\frac{3}{14}\right)^2=\frac{  325}{98}
>O &= getCircleCenter(LL); $O
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-062.png
% // latex: \left[ \frac{3}{14} , \frac{5}{14} \right] 
% Gambar lingkaran dan pusatnya. Cu dan U bersifat simbolik. Kita evaluasi
% ekspresi-ekspresi ini untuk Euler.
>plotCircle(LL()); plotPoint(O(),"O"):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-063.png
% Kita dapat menghitung perpotongan garis-garis tinggi di ABC (titik tinggi) secara numerik
% dengan perintah berikut.
>H &= lineIntersection(perpendicular(A,lineThrough(C,B)),...
>  perpendicular(B,lineThrough(A,C))); $H
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-064.png
% // latex: \left[ \frac{11}{7} , \frac{2}{7} \right] 
% Sekarang kita dapat menghitung garis Euler segitiga tersebut.
>el &= lineThrough(H,O); $getLineEquation(el,x,y)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-065.png
% // latex: -\frac{19\,y}{14}-\frac{x}{14}=-\frac{1}{2}
% Tambahkan ke gambar kita.
>plotPoint(H(),"H"); plotLine(el(),"Garis Euler"):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-066.png
% Titik berat seharusnya berada pada garis ini.
>M &= (A+B+C)/3; $getLineEquation(el,x,y) with [x=M[1],y=M[2]]
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-067.png
% // latex: -\frac{1}{2}=-\frac{1}{2}
>plotPoint(M(),"M"): // titik berat
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-068.png
% Teori mengatakan MH=2*MO. Kita perlu menyederhanakan dengan radcan untuk mendapatkannya.
>$distance(M,H)/distance(M,O)|radcan
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-069.png
% // latex: 2
% Terdapat juga fungsi untuk sudut.
>$computeAngle(A,C,B), degprint(%())
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-070.png
% // latex: \arccos \left(\frac{4}{\sqrt{5}\,\sqrt{13}}\right)
60°15'18.43''
% Persamaan untuk pusat lingkaran dalam tidak terlalu bagus.
>Q &= lineIntersection(angleBisector(A,C,B),angleBisector(C,B,A))|radcan; $Q
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-071.png
% // latex: \left[ \frac{\left(2^{\frac{3}{2}}+1\right)\,\sqrt{5}\,\sqrt{13}-15  \,\sqrt{2}+3}{14} , \frac{\left(\sqrt{2}-3\right)\,\sqrt{5}\,\sqrt{  13}+5\,2^{\frac{3}{2}}+5}{14} \right] 
% Mari kita hitung juga ekspresi untuk jari-jari lingkaran dalam.
>r &= distance(Q,projectToLine(Q,lineThrough(A,B)))|ratsimp; $r
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-072.png
% // latex: \frac{\sqrt{\left(-41\,\sqrt{2}-31\right)\,\sqrt{5}\,\sqrt{13}+115  \,\sqrt{2}+614}}{7\,\sqrt{2}}
>LD &=  circleWithCenter(Q,r); // Lingkaran dalam
% Mari kita tambahkan ini ke gambar.
>color(5); plotCircle(LD()):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-073.png
% Hasil yang diharapkan: luas = 7/2 (nilai mutlak); c: -x+3y=-2; O = [3/14,5/14];
% H = [11/7,2/7]; garis Euler memuat M = [2/3,2/3] (kesamaan -1/2 = -1/2); MH/MO = 2;
% sudut ACB = 60Â°15'18.43''.
% Penjelasan: O, M, H segaris dan M membagi OH dengan perbandingan 1 : 2 (OM : MH = 1 : 2).
% 
% ** Parabola
% 
% Selanjutnya akan dicari persamaan tempat kedudukan titik-titik yang berjarak sama ke titik C
% dan ke garis AB.
>p &= getHesseForm(lineThrough(A,B),x,y,C)-distance([x,y],C); $p='0
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-074.png
% // latex: \frac{3\,y-x+2}{\sqrt{10}}-\sqrt{\left(2-y\right)^2+\left(1-x  \right)^2}=0
% Persamaan tersebut dapat digambar menjadi satu dengan gambar sebelumnya.
>plot2d(p,level=0,add=1,contourcolor=6):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-075.png
% Ini seharusnya berupa suatu fungsi, tetapi penyelesai (solver) standar Maxima hanya dapat
% menemukan solusinya jika persamaan dikuadratkan. Akibatnya, kita mendapatkan solusi palsu.
>akar &= solve(getHesseForm(lineThrough(A,B),x,y,C)^2-distance([x,y],C)^2,y)

        [y = - 3 x - sqrt(70) sqrt(9 - 2 x) + 26, 
                              y = - 3 x + sqrt(70) sqrt(9 - 2 x) + 26]

% Solusi pertama adalah
% 
% maxima: akar[1]
% 
% Menambahkan solusi pertama ke gambar menunjukkan bahwa itu memang lintasan yang kita cari.
% Teori mengatakan bahwa itu adalah parabola yang terputar.
>plot2d(&rhs(akar[1]),add=1):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-076.png
>function g(x) &= rhs(akar[1]); $'g(x)= g(x)// fungsi yang mendefinisikan kurva di atas
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-077.png
% // latex: g\left(x\right)=-3\,x-\sqrt{70}\,\sqrt{9-2\,x}+26
>T &=[-1, g(-1)]; // ambil sebarang titik pada kurva tersebut
>dTC &= distance(T,C); $fullratsimp(dTC), $float(%) // jarak T ke C
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-078.png
% // latex: \sqrt{1503-54\,\sqrt{11}\,\sqrt{70}}
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-079.png
% // latex: 2.135605779339061
>U &= projectToLine(T,lineThrough(A,B)); $U // proyeksi T pada garis AB
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-080.png
% // latex: \left[ \frac{80-3\,\sqrt{11}\,\sqrt{70}}{10} , \frac{20-\sqrt{11}\,  \sqrt{70}}{10} \right] 
>dU2AB &= distance(T,U); $fullratsimp(dU2AB), $float(%) // jarak T ke AB
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-081.png
% // latex: \sqrt{1503-54\,\sqrt{11}\,\sqrt{70}}
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-082.png
% // latex: 2.135605779339061
% Ternyata jarak T ke C sama dengan jarak T ke AB. Coba Anda pilih titik T yang lain dan
% ulangi perhitungan-perhitungan di atas untuk menunjukkan bahwa hasilnya juga sama.
% 
% *** Latihan Contoh 4: Memilih titik T yang lain pada parabola
% 
% Titik T diambil pada x = 0, x = 2, dan x = 4 (daerah asal kurva: 9 - 2x >= 0, jadi x <= 4.5).
% Jarak ke fokus C dan jarak ke direktriks AB dihitung secara numerik.
>T2=[0,g(0)]; distance(T2,C), jarakKeGaris(T2,lineThrough(A,B))
1.48645948177
1.48645948177
>T3=[2,g(2)]; distance(T3,C), jarakKeGaris(T3,lineThrough(A,B))
1.22542661171
1.22542661171
>T4=[4,g(4)]; distance(T4,C), jarakKeGaris(T4,lineThrough(A,B))
4.71185670748
4.71185670748
% Hasil yang diharapkan (jarak ke C, jarak ke AB):
% x = 0: (1.48646, 1.48646); x = 2: (1.22543, 1.22543); x = 4: (4.71186, 4.71186).
% Penjelasan: untuk setiap titik T pada kurva, jaraknya ke C sama dengan jaraknya ke garis AB.
% Inilah sifat definisi parabola (jarak ke fokus = jarak ke direktriks). Titik di x=-1 memberi
% 2.1356 untuk keduanya.
% 
% * Contoh 5: Trigonometri Rasional
% 
% ** Uraian Materi
% 
% Trigonometri rasional (N. J. Wildberger, "Divine Proportions") mengganti jarak dengan kuadran
% (quadrance) dan sudut dengan spread, sehingga banyak perhitungan cukup memakai bilangan
% rasional.
% 
% - Kuadran dua titik: Q(A,B) = (x2-x1)^2 + (y2-y1)^2 (kuadrat jarak).
% - Spread dua garis: s = sin^2(theta), nilainya 0 (sejajar) sampai 1 (tegak lurus).
% - Teorema Pythagoras menjadi Q1 + Q2 = Q3 (segitiga siku-siku, spread 1).
% - Hukum silang (cross law): (Q1+Q2-Q3)^2 = 4 Q1 Q2 (1 - s3), setara hukum kosinus.
% - Hukum spread: s1/Q1 = s2/Q2 = s3/Q3, setara hukum sinus.
% - Spread rangkap tiga (triple spread): (s1+s2+s3)^2 = 2(s1^2+s2^2+s3^2) + 4 s1 s2 s3.
% 
% Perhitungan di bawah memakai Maxima, sehingga keuntungan utama trigonometri rasional
% (dapat dikerjakan dengan kertas dan pensil saja) tidak terlihat; Anda dianjurkan memeriksa
% hasil-hasilnya tanpa komputer.
% 
% ** Penyelesaian dengan EMT
% 
% Ini terinspirasi dari ceramah N.J.Wildberger. Dalam bukunya "Divine Proportions", Wildberger
% mengusulkan penggantian pengertian klasik jarak dan sudut dengan kuadran dan spread.
% Dengan keduanya, memang dimungkinkan menghindari fungsi trigonometri pada banyak contoh, dan
% tetap "rasional".
% 
% Berikut ini, saya memperkenalkan konsep-konsepnya, dan menyelesaikan beberapa soal. Saya memakai
% perhitungan simbolik Maxima di sini, yang menyembunyikan keuntungan utama trigonometri rasional,
% yaitu bahwa perhitungan dapat dilakukan hanya dengan kertas dan pensil. Anda diundang untuk
% memeriksa hasil-hasilnya tanpa komputer.
% 
% Intinya, perhitungan rasional simbolik sering menghasilkan hasil yang sederhana. Sebaliknya,
% trigonometri klasik menghasilkan hasil trigonometri yang rumit, yang hanya bisa dievaluasi
% menjadi hampiran numerik.
% 
% Catatan perbaikan: variabel Maxima dibersihkan dulu karena cc, a, b, c dari contoh sebelumnya
% masih tersimpan dan membuat hasil crosslaw di versi asli salah.
>&remvalue();
>load geometry;
% Sebagai pengenalan pertama, kita pakai segitiga siku-siku dengan perbandingan Mesir yang
% terkenal 3, 4 dan 5. Perintah-perintah berikut adalah perintah Euler untuk menggambar
% geometri bidang yang terdapat dalam file Euler "geometry.e".
>C&:=[0,0]; A&:=[4,0]; B&:=[0,3]; ...
>setPlotRange(-1,5,-1,5); ...
>plotPoint(A,"A"); plotPoint(B,"B"); plotPoint(C,"C"); ...
>plotSegment(B,A,"c"); plotSegment(A,C,"b"); plotSegment(C,B,"a"); ...
>insimg(30);
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-083.png
% Tentu saja,
% 
% latex: \sin(w_a)=\frac{a}{c},
% 
% dengan wa adalah sudut di A. Cara biasa untuk menghitung sudut ini adalah dengan mengambil
% invers fungsi sinus. Hasilnya adalah sudut yang "tidak enak dicerna", yang hanya bisa
% dicetak secara hampiran.
>wa := arcsin(3/5); degprint(wa)
36°52'11.63''
% Trigonometri rasional mencoba menghindari hal ini.
% 
% Pengertian pertama trigonometri rasional adalah kuadran, yang menggantikan jarak. Sebenarnya,
% kuadran hanyalah jarak yang dikuadratkan. Berikut ini, a, b, dan c menyatakan kuadran
% sisi-sisinya.
% 
% Teorema Pythogoras kemudian menjadi sederhana: a+b=c.
>a &= 3^2; b &= 4^2; c &= 5^2; &a+b=c

                               25 = 25

% Pengertian kedua trigonometri rasional adalah spread. Spread mengukur bukaan antara
% garis-garis. Nilainya 0, jika garis-garisnya sejajar, dan 1, jika garis-garisnya tegak lurus.
% Spread adalah kuadrat sinus sudut antara dua garis.
% 
% Spread garis AB dan AC pada gambar di atas didefinisikan sebagai
% 
% latex: s_a = \sin(\alpha)^2 = \frac{a}{c},
% 
% dengan a dan c adalah kuadran-kuadran pada sebarang segitiga siku-siku dengan satu sudut di A.
>sa &= a/c; $sa
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-084.png
% // latex: \frac{9}{25}
% Ini tentunya lebih mudah dihitung daripada sudut. Tetapi Anda kehilangan sifat bahwa
% sudut-sudut dapat dijumlahkan dengan mudah.
% 
% Tentu saja, kita dapat mengubah nilai hampiran sudut wa menjadi spread, dan mencetaknya
% sebagai pecahan.
>fracprint(sin(wa)^2)
9/25
% Hukum kosinus pada trigonometri klasik diterjemahkan menjadi "hukum silang" berikut.
% 
% latex: (c+b-a)^2 = 4 b c \, (1-s_a)
% 
% Di sini a, b, dan c adalah kuadran sisi-sisi segitiga, dan sa adalah spread di titik sudut A.
% Sisi a, seperti biasa, berhadapan dengan titik sudut A.
% 
% Hukum-hukum ini sudah diimplementasikan dalam file geometry.e yang kita panggil ke Euler.
>$crosslaw(aa,bb,cc,saa)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-085.png
% // latex: \left[ \left({\it bb}-{\it aa}+\frac{7}{6}\right)^2 , \left(  {\it bb}-{\it aa}+\frac{7}{6}\right)^2 , \left({\it bb}-{\it aa}+  \frac{5}{3\,\sqrt{2}}\right)^2 \right] =\left[ \frac{14\,{\it bb}\,  \left(1-{\it saa}\right)}{3} , \frac{14\,{\it bb}\,\left(1-{\it saa}  \right)}{3} , \frac{5\,2^{\frac{3}{2}}\,{\it bb}\,\left(1-{\it saa}  \right)}{3} \right] 
% Pada kasus kita didapat
>$crosslaw(a,b,c,sa)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-086.png
% // latex: 1024=1024
% Mari kita pakai hukum silang ini untuk mencari spread di A. Untuk itu, kita buat hukum silang
% untuk kuadran a, b, dan c, lalu selesaikan untuk spread sa yang tidak diketahui.
% 
% Anda dapat melakukan ini dengan mudah secara manual, tetapi saya memakai Maxima. Tentu saja,
% kita mendapatkan hasil yang sudah kita punya.
>$crosslaw(a,b,c,x), $solve(%,x)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-087.png
% // latex: 1024=1600\,\left(1-x\right)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-088.png
% // latex: \left[ x=\frac{9}{25} \right] 
% Kita sudah mengetahui ini. Definisi spread adalah kasus khusus dari hukum silang.
% 
% Kita juga dapat menyelesaikan ini untuk a,b,c umum. Hasilnya adalah rumus yang menghitung
% spread suatu sudut segitiga bila diketahui kuadran ketiga sisinya.
>$solve(crosslaw(aa,bb,cc,x),x)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-089.png
% // latex: \left[ \left[ \frac{168\,{\it bb}\,x+36\,{\it bb}^2+\left(-72\,  {\it aa}-84\right)\,{\it bb}+36\,{\it aa}^2-84\,{\it aa}+49}{36} ,   \frac{168\,{\it bb}\,x+36\,{\it bb}^2+\left(-72\,{\it aa}-84\right)  \,{\it bb}+36\,{\it aa}^2-84\,{\it aa}+49}{36} , \frac{15\,2^{\frac{  5}{2}}\,{\it bb}\,x+18\,{\it bb}^2+\left(-36\,{\it aa}-15\,2^{\frac{  3}{2}}\right)\,{\it bb}+18\,{\it aa}^2-15\,2^{\frac{3}{2}}\,{\it aa}  +25}{18} \right] =0 \right] 
% Kita dapat membuat fungsi dari hasil itu. Fungsi seperti itu sudah didefinisikan dalam file
% geometry.e milik Euler.
>$spread(a,b,c)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-090.png
% // latex: \frac{9}{25}
% Sebagai contoh, kita dapat memakainya untuk menghitung sudut segitiga dengan sisi-sisi
% 
% latex: a, \quad a, \quad \frac{4a}{7}
% 
% Hasilnya rasional, yang tidak mudah didapat bila kita memakai trigonometri klasik.
>$spread(a,a,4*a/7)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-091.png
% // latex: \frac{6}{7}
% Ini adalah sudut dalam derajat.
>degprint(arcsin(sqrt(6/7)))
67°47'32.44''
% 
% ** Contoh Lain
% 
% Sekarang, mari kita coba contoh yang lebih lanjut.
% 
% Kita tentukan tiga titik sudut segitiga sebagai berikut.
>A&:=[1,2]; B&:=[4,3]; C&:=[0,4]; ...
>setPlotRange(-1,5,1,7); ...
>plotPoint(A,"A"); plotPoint(B,"B"); plotPoint(C,"C"); ...
>plotSegment(B,A,"c"); plotSegment(A,C,"b"); plotSegment(C,B,"a"); ...
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-092.png
% Dengan Pythogoras, mudah menghitung jarak antara dua titik. Mula-mula saya pakai fungsi
% distance dari file Euler untuk geometri. Fungsi distance memakai geometri klasik.
>$distance(A,B)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-093.png
% // latex: \sqrt{10}
% Euler juga memiliki fungsi untuk kuadran antara dua titik.
% 
% Pada contoh berikut, karena c+b bukan a, segitiga ini bukan segitiga siku-siku.
>c &= quad(A,B); $c, b &= quad(A,C); $b, a &= quad(B,C); $a,
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-094.png
% // latex: 10
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-095.png
% // latex: 5
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-096.png
% // latex: 17
% Pertama, mari kita hitung sudut tradisional. Fungsi computeAngle memakai metode biasa yang
% berdasarkan hasil kali titik dua vektor. Hasilnya berupa hampiran bilangan floating point.
% 
% latex: A=<1,2>\quad B=<4,3>,\quad C=<0,4>
% latex: \mathbf{a}=C-B=<-4,1>,\quad \mathbf{c}=A-B=<-3,-1>,\quad \beta=\angle ABC
% latex: \mathbf{a}.\mathbf{c}=|\mathbf{a}|.|\mathbf{c}|\cos \beta
% latex: \cos \angle ABC =\cos\beta=\frac{\mathbf{a}.\mathbf{c}}{|\mathbf{a}|.|\mathbf{c}|}=\frac{12-1}{\sqrt{17}\sqrt{10}}=\frac{11}{\sqrt{17}\sqrt{10}}
>wb &= computeAngle(A,B,C); $wb, $(wb/pi*180)()
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-097.png
% // latex: \arccos \left(\frac{11}{\sqrt{10}\,\sqrt{17}}\right)
32.4711922908
% Dengan pensil dan kertas, kita dapat melakukan hal yang sama dengan hukum silang. Kita
% masukkan kuadran a, b, dan c ke dalam hukum silang dan selesaikan untuk x.
>$crosslaw(a,b,c,x), $solve(%,x), //(b+c-a)^=4b.c(1-x)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-098.png
% // latex: 4=200\,\left(1-x\right)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-099.png
% // latex: \left[ x=\frac{49}{50} \right] 
% Itulah yang dikerjakan fungsi spread yang didefinisikan dalam "geometry.e".
>sb &= spread(b,a,c); $sb
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-100.png
% // latex: \frac{49}{170}
% Maxima mendapatkan hasil yang sama dengan trigonometri biasa, bila kita paksa. Ia
% menyelesaikan suku sin(arccos(...)) menjadi hasil pecahan. Kebanyakan mahasiswa tidak
% dapat melakukan ini.
>$sin(computeAngle(A,B,C))^2
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-101.png
% // latex: \frac{49}{170}
% Setelah kita punya spread di B, kita dapat menghitung tinggi ha pada sisi a. Ingat bahwa
% 
% latex: s_b=\frac{h_a}{c}
% 
% menurut definisi.
>ha &= c*sb; $ha
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-102.png
% // latex: \frac{49}{17}
% Gambar berikut dihasilkan dengan program geometri C.a.R., yang dapat menggambar kuadran dan
% spread.
% 
% Menurut definisi, panjang ha adalah akar kuadrat dari kuadrannya.
>$sqrt(ha)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-103.png
% // latex: \frac{7}{\sqrt{17}}
% Sekarang kita dapat menghitung luas segitiga. Jangan lupa, bahwa kita sedang berurusan
% dengan kuadran!
>$sqrt(ha)*sqrt(a)/2
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-104.png
% // latex: \frac{7}{2}
% Rumus determinan yang biasa menghasilkan hal yang sama.
>$areaTriangle(B,A,C)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-105.png
% // latex: \frac{7}{2}
% Hasil yang diharapkan: c = 10, b = 5, a = 17; sudut B = 32.4712Â°; sb = 49/170; ha = 49/17;
% luas = 7/2 (sama dengan rumus determinan).
% 
% ** Rumus Heron
% 
% Sekarang, mari kita selesaikan soal ini secara umum!
>&remvalue(a,b,c,sb,ha);
% Pertama kita hitung spread di B untuk segitiga dengan sisi a, b, dan c. Kemudian kita hitung
% luas kuadrat (disebut "quadrea"?), memfaktorkannya dengan Maxima, dan kita mendapatkan rumus
% Heron yang terkenal.
% 
% Harus diakui, ini sulit dikerjakan dengan pensil dan kertas.
>$spread(b^2,c^2,a^2), $factor(%*c^2*a^2/4)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-106.png
% // latex: \frac{-c^4-\left(-2\,b^2-2\,a^2\right)\,c^2-b^4+2\,a^2\,b^2-a^4}{4  \,a^2\,c^2}
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-107.png
% // latex: \frac{\left(-c+b+a\right)\,\left(c-b+a\right)\,\left(c+b-a\right)\,  \left(c+b+a\right)}{16}
% 
% ** Aturan Spread Rangkap Tiga
% 
% Kelemahan spread adalah bahwa spread tidak lagi dijumlahkan seperti sudut.
% 
% Namun, ketiga spread suatu segitiga memenuhi aturan "spread rangkap tiga" berikut.
>&remvalue(sa,sb,sc); $triplespread(sa,sb,sc)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-108.png
% // latex: \left({\it sc}+{\it sb}+{\it sa}\right)^2=2\,\left({\it sc}^2+  {\it sb}^2+{\it sa}^2\right)+4\,{\it sa}\,{\it sb}\,{\it sc}
% Aturan ini berlaku untuk sebarang tiga sudut yang berjumlah 180Â°.
% 
% latex: \alpha+\beta+\gamma=\pi
% 
% Karena spread
% 
% latex: \alpha, \pi-\alpha
% 
% sama, aturan spread rangkap tiga juga benar, jika
% 
% latex: \alpha+\beta=\gamma
% 
% Karena spread sudut negatif sama, aturan spread rangkap tiga juga berlaku, jika
% 
% latex: \alpha+\beta+\gamma=0
% 
% Sebagai contoh, kita dapat menghitung spread sudut 60Â°. Nilainya 3/4. Persamaan ini punya
% solusi kedua, yaitu semua spread bernilai 0.
>$solve(triplespread(x,x,x),x)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-109.png
% // latex: \left[ x=\frac{3}{4} , x=0 \right] 
% Spread sudut 90Â° jelas 1. Jika dua sudut berjumlah 90Â°, spread keduanya menyelesaikan
% persamaan spread rangkap tiga dengan a,b,1. Dengan perhitungan berikut kita mendapatkan a+b=1.
>$triplespread(x,y,1), $solve(%,x)
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-110.png
% // latex: \left(y+x+1\right)^2=2\,\left(y^2+x^2+1\right)+4\,x\,y
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-111.png
% // latex: \left[ x=1-y \right] 
% Karena spread 180Â°-t sama dengan spread t, rumus spread rangkap tiga juga berlaku, jika satu
% sudut adalah jumlah atau selisih dua sudut lainnya.
% 
% Jadi kita dapat mencari spread sudut rangkap. Perhatikan bahwa ada dua solusi lagi. Kita
% jadikan ini sebuah fungsi.
>$solve(triplespread(a,a,x),x), function doublespread(a) &= factor(rhs(%[1]))
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-112.png
% // latex: \left[ x=4\,a-4\,a^2 , x=0 \right] 

                            - 4 (a - 1) a

% Hasil yang diharapkan: spread 60Â° = 3/4; a+b = 1 untuk dua sudut komplementer;
% doublespread(a) = 4a(1-a).
% 
% ** Garis Bagi Sudut
% 
% Ini adalah situasi yang sudah kita ketahui.
>C&:=[0,0]; A&:=[4,0]; B&:=[0,3]; ...
>setPlotRange(-1,5,-1,5); ...
>plotPoint(A,"A"); plotPoint(B,"B"); plotPoint(C,"C"); ...
>plotSegment(B,A,"c"); plotSegment(A,C,"b"); plotSegment(C,B,"a"); ...
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-113.png
% Mari kita hitung panjang garis bagi sudut di A. Tetapi kita ingin menyelesaikannya untuk
% a,b,c umum.
>&remvalue(a,b,c);
% Jadi pertama-tama kita hitung spread sudut yang dibagi dua di A, memakai rumus spread
% rangkap tiga.
% 
% Masalah rumus ini muncul lagi. Rumus ini punya dua solusi. Kita harus memilih yang benar.
% Solusi yang lain berkaitan dengan sudut yang dibagi dua 180Â°-wa.
>$triplespread(x,x,a/(a+b)), $solve(%,x), sa2 &= rhs(%[1]); $sa2
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-114.png
% // latex: \left(2\,x+\frac{a}{b+a}\right)^2=2\,\left(2\,x^2+\frac{a^2}{\left(  b+a\right)^2}\right)+\frac{4\,a\,x^2}{b+a}
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-115.png
% // latex: \left[ x=\frac{-\sqrt{b}\,\sqrt{b+a}+b+a}{2\,b+2\,a} , x=\frac{  \sqrt{b}\,\sqrt{b+a}+b+a}{2\,b+2\,a} \right] 
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-116.png
% // latex: \frac{-\sqrt{b}\,\sqrt{b+a}+b+a}{2\,b+2\,a}
% Mari kita periksa untuk segiempat (segitiga) Mesir.
>$sa2 with [a=3^2,b=4^2]
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-117.png
% // latex: \frac{1}{10}
% Kita dapat mencetak sudutnya di Euler, setelah memindahkan spread ke radian.
>wa2 := arcsin(sqrt(1/10)); degprint(wa2)
18°26'5.82''
% Titik P adalah perpotongan garis bagi sudut dengan sumbu-y.
>P := [0,tan(wa2)*4]
[0,  1.33333]
>plotPoint(P,"P"); plotSegment(A,P):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-118.png
% Mari kita periksa sudut-sudut pada contoh khusus kita.
>computeAngle(C,A,P), computeAngle(P,A,B)
0.321750554397
0.321750554397
% Sekarang kita hitung panjang garis bagi AP.
% 
% Kita pakai teorema sinus pada segitiga APC. Teorema ini menyatakan bahwa
% 
% latex: \frac{BC}{\sin(w_a)} = \frac{AC}{\sin(w_b)} = \frac{AB}{\sin(w_c)}
% 
% berlaku pada sebarang segitiga. Kuadratkan, maka ia diterjemahkan menjadi apa yang disebut
% "hukum spread"
% 
% latex: \frac{a}{s_a} = \frac{b}{s_b} = \frac{c}{s_b}
% 
% dengan a,b,c menyatakan kuadran-kuadran.
% 
% Karena spread CPA adalah 1-sa2, dari situ kita dapatkan bisa/1=b/(1-sa2) dan dapat menghitung
% bisa (kuadran garis bagi sudut).
>&factor(ratsimp(b/(1-sa2))); bisa &= %; $bisa
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-119.png
% // latex: \frac{2\,b\,\left(b+a\right)}{\sqrt{b}\,\sqrt{b+a}+b+a}
% Mari kita periksa rumus ini untuk nilai-nilai Mesir kita.
>sqrt(mxmeval("at(bisa,[a=3^2,b=4^2])")), distance(A,P)
4.21637021356
4.21637021356
% Kita juga dapat menghitung P memakai rumus spread.
>py&=factor(ratsimp(sa2*bisa)); $py
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-120.png
% // latex: -\frac{b\,\left(\sqrt{b}\,\sqrt{b+a}-b-a\right)}{\sqrt{b}\,\sqrt{b+  a}+b+a}
% Nilainya sama dengan yang kita dapat dengan rumus trigonometri.
>sqrt(mxmeval("at(py,[a=3^2,b=4^2])"))
1.33333333333
% Hasil yang diharapkan: sa2 = 1/10; sudut 18Â°26'5.82''; P = [0, 1.33333];
% AP = 4.21637; kedua sudut CAP dan PAB = 0.321751 rad.
% 
% ** Sudut Tali Busur (Chord Angle)
% 
% Perhatikan situasi berikut.
>setPlotRange(1.2); ...
>color(1); plotCircle(circleWithCenter([0,0],1)); ...
>A:=[cos(1),sin(1)]; B:=[cos(2),sin(2)]; C:=[cos(6),sin(6)]; ...
>plotPoint(A,"A"); plotPoint(B,"B"); plotPoint(C,"C"); ...
>color(3); plotSegment(A,B,"c"); plotSegment(A,C,"b"); plotSegment(C,B,"a"); ...
>color(1); O:=[0,0];  plotPoint(O,"0"); ...
>plotSegment(A,O); plotSegment(B,O); plotSegment(C,O,"r"); ...
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-121.png
% Kita dapat memakai Maxima untuk menyelesaikan rumus spread rangkap tiga untuk sudut-sudut di
% pusat O terhadap r. Dengan demikian kita mendapatkan rumus untuk kuadrat jari-jari
% lingkaran luar dalam bentuk kuadran-kuadran sisinya.
% 
% Kali ini, Maxima menghasilkan beberapa nol kompleks, yang kita abaikan.
>&remvalue(a,b,c,r); // hapus nilai-nilai sebelumnya untuk perhitungan baru
>rabc &= rhs(solve(triplespread(spread(b,r,r),spread(a,r,r),spread(c,r,r)),r)[4]); $rabc
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-122.png
% // latex: -\frac{a\,b\,c}{c^2-2\,b\,c+a\,\left(-2\,c-2\,b\right)+b^2+a^2}
% Kita dapat menjadikan itu fungsi Euler.
>function periradius(a,b,c) &= rabc;
% Mari kita periksa hasilnya untuk titik-titik A,B,C kita.
>a:=quadrance(B,C); b:=quadrance(A,C); c:=quadrance(A,B);
% Jari-jarinya memang 1.
>periradius(a,b,c)
1
% Faktanya, spread CBA hanya bergantung pada b dan c. Ini adalah teorema sudut tali busur.
>$spread(b,a,c)*rabc | ratsimp
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-123.png
% // latex: \frac{b}{4}
% Sebenarnya spread tersebut adalah b/(4r), dan kita lihat bahwa sudut tali busur dari tali
% busur b adalah setengah sudut pusat.
>$doublespread(b/(4*r))-spread(b,r,r) | ratsimp
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-124.png
% // latex: 0
% Hasil yang diharapkan: periradius = 1; hasil kali = b/4; selisih terakhir = 0.
% 
% * Contoh 6: Jarak Minimal pada Bidang
% 
% ** Uraian Materi
% 
% Titik Fermat (titik Torricelli) suatu segitiga adalah titik F yang meminimumkan jumlah jarak
% FA + FB + FC. Jika semua sudut segitiga kurang dari 120 derajat, F berada di dalam segitiga
% dan melihat setiap sisi dengan sudut 120 derajat (sudut AFB = BFC = CFA = 120Â°). Jika ada
% sudut yang sama atau lebih dari 120 derajat, titik minimumnya adalah titik sudut tersebut.
% Konstruksinya: buat segitiga sama sisi di luar pada dua sisi; garis dari titik sudut ke puncak
% segitiga sama sisi di hadapannya berpotongan di F.
% 
% Untuk dua titik A dan B, himpunan titik dengan MA+MB = konstanta adalah elips dengan fokus A dan B.
% 
% ** Penyelesaian dengan EMT
% 
% ** Catatan pendahuluan
% 
% Fungsi yang mengaitkan titik M pada bidang dengan jarak AM antara titik tetap A dan M,
% mempunyai garis-garis tinggi (kontur) yang cukup sederhana: lingkaran-lingkaran dengan pusat A.
>&remvalue();
>A=[-1,-1];
>function d1(x,y):=sqrt((x-A[1])^2+(y-A[2])^2)
>fcontour("d1",xmin=-2,xmax=0,ymin=-2,ymax=0,hue=1, ...
>title="Jika tampak elips, atur jendela Anda menjadi persegi"):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-125.png
% dan grafiknya juga cukup sederhana: bagian atas sebuah kerucut:
>plot3d("d1",xmin=-2,xmax=0,ymin=-2,ymax=0):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-126.png
% Tentu saja minimum 0 dicapai di A.
% 
% ** Dua titik
% 
% Sekarang kita lihat fungsi MA+MB dengan A dan B dua titik (tetap). Ada "fakta yang terkenal"
% bahwa kurva-kurva kontur-nya berupa elips, dengan titik fokus A dan B; kecuali minimum AB yang
% konstan pada ruas [AB]:
>B=[1,-1];
>function d2(x,y):=d1(x,y)+sqrt((x-B[1])^2+(y-B[2])^2)
>fcontour("d2",xmin=-2,xmax=2,ymin=-3,ymax=1,hue=1):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-127.png
% Grafiknya lebih menarik:
>plot3d("d2",xmin=-2,xmax=2,ymin=-3,ymax=1):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-128.png
% Pembatasan pada garis (AB) lebih terkenal:
>plot2d("abs(x+1)+abs(x-1)",xmin=-3,xmax=3):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-129.png
% 
% ** Tiga titik
% 
% Sekarang hal-hal menjadi kurang sederhana: Agak kurang terkenal bahwa MA+MB+MC mencapai
% minimumnya di satu titik pada bidang, tetapi menentukannya tidak sesederhana itu:
% 
% 1) Jika salah satu sudut segitiga ABC lebih dari 120Â° (misalkan di A), maka minimum dicapai
% tepat di titik ini (misalkan AB+AC).
% 
% Contoh:
>C=[-4,1];
>function d3(x,y):=d2(x,y)+sqrt((x-C[1])^2+(y-C[2])^2)
>plot3d("d3",xmin=-5,xmax=3,ymin=-4,ymax=4);
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-130.png
>fcontour("d3",xmin=-4,xmax=1,ymin=-2,ymax=2,hue=1,title="Minimum ada di A");
>P=(A_B_C_A)'; plot2d(P[1],P[2],add=1,color=12);
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-131.png
% 2) Tetapi jika semua sudut segitiga ABC kurang dari 120Â°, minimum berada pada suatu titik F di
% bagian dalam segitiga, yang merupakan satu-satunya titik yang melihat sisi-sisi ABC dengan
% sudut yang sama (maka masing-masing 120Â°):
>C=[-0.5,1];
>plot3d("d3",xmin=-2,xmax=2,ymin=-2,ymax=2):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-132.png
>fcontour("d3",xmin=-2,xmax=2,ymin=-2,ymax=2,hue=1,title="Titik Fermat");
>P=(A_B_C_A)'; plot2d(P[1],P[2],add=1,color=12);
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-133.png
% Merupakan kegiatan yang menarik untuk mewujudkan gambar di atas dengan perangkat lunak
% geometri; misalnya, saya tahu satu perangkat lunak yang ditulis dalam Java dan memiliki
% instruksi "garis kontur"...
% 
% Semua hal di atas ditemukan oleh seorang hakim Perancis bernama Pierre de Fermat; ia menulis
% surat kepada para dilettante lain seperti pastor Marin Mersenne dan Blaise Pascal yang bekerja
% di bagian pajak penghasilan. Jadi titik tunggal F sehingga FA+FB+FC minimal disebut titik
% Fermat segitiga tersebut. Tetapi tampaknya beberapa tahun sebelumnya, orang Italia Torricelli
% telah menemukan titik ini sebelum Fermat! Bagaimanapun tradisinya adalah menandai titik ini F...
% 
% ** Empat titik
% 
% Langkah berikutnya adalah menambahkan titik keempat D dan mencoba meminimumkan MA+MB+MC+MD;
% misalkan Anda adalah operator TV kabel dan ingin mencari di lahan mana antena harus dipasang
% agar Anda bisa melayani empat desa dan memakai kabel sependek mungkin!
>D=[1,1];
>function d4(x,y):=d3(x,y)+sqrt((x-D[1])^2+(y-D[2])^2)
>plot3d("d4",xmin=-1.5,xmax=1.5,ymin=-1.5,ymax=1.5):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-134.png
>fcontour("d4",xmin=-1.5,xmax=1.5,ymin=-1.5,ymax=1.5,hue=1);
>P=(A_B_C_D)'; plot2d(P[1],P[2],points=1,add=1,color=12);
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-135.png
% Masih ada minimum dan dicapai bukan di titik A, B, C, ataupun D:
>function f(x):=d4(x[1],x[2])
>neldermin("f",[0.2,0.2])
[0.142858,  0.142857]
% Tampaknya pada kasus ini, koordinat titik optimalnya rasional atau hampir rasional...
% 
% Sekarang jika ABCD adalah persegi, kita harapkan titik optimalnya adalah pusat ABCD:
>C=[-1,1];
>plot3d("d4",xmin=-1,xmax=1,ymin=-1,ymax=1):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-136.png
>fcontour("d4",xmin=-1.5,xmax=1.5,ymin=-1.5,ymax=1.5,hue=1);
>P=(A_B_C_D)'; plot2d(P[1],P[2],add=1,color=12,points=1);
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-137.png
% Hasil yang diharapkan: untuk empat titik A=[-1,-1], B=[1,-1], C=[-0.5,1], D=[1,1],
% neldermin mendapatkan titik sekitar [0.142858, 0.142857] (kira-kira [1/7,1/7]).
% Untuk persegi (C=[-1,1]) titik optimalnya adalah pusat persegi, [0,0].
% 
% * Contoh 7: Bola Dandelin dengan Povray
% 
% ** Uraian Materi
% 
% Teorema Dandelin: bila sebuah bidang memotong kerucut tegak membentuk elips, maka terdapat dua
% bola yang menyinggung kerucut dan bidang tersebut. Titik-titik singgung kedua bola dengan
% bidang adalah titik fokus elips. Untuk titik T pada elips, TF1 + TF2 sama dengan jarak antara
% dua lingkaran singgung bola dengan kerucut, diukur sepanjang garis pelukis, sehingga konstan.
% Ini menjelaskan mengapa irisan kerucut ini adalah elips (jumlah jarak ke dua fokus konstan).
% 
% ** Penyelesaian dengan EMT
% 
% Anda dapat menjalankan demonstrasi ini, jika Anda telah memasang Povray, dan pvengine.exe berada
% di path program.
% 
% Pertama kita hitung jari-jari bola-bola tersebut.
% 
% Jika Anda melihat gambar di bawah, Anda melihat bahwa kita membutuhkan dua lingkaran yang
% menyinggung dua garis yang membentuk kerucut, dan satu garis yang membentuk bidang yang
% memotong kerucut.
% 
% Kita pakai file geometry.e dari Euler untuk ini.
>load geometry;
% Pertama dua garis yang membentuk kerucut.
>g1 &= lineThrough([0,0],[1,a])

                             [- a, 1, 0]

>g2 &= lineThrough([0,0],[-1,a])

                            [- a, - 1, 0]

% Kemudian garis ketiga.
>g &= lineThrough([-1,0],[1,1])

                             [- 1, 2, 1]

% Kita gambar semuanya sejauh ini.
>setPlotRange(-1,1,0,2);
>color(black); plotLine(g(),"")
>a:=2; color(blue); plotLine(g1(),""), plotLine(g2(),""):
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-138.png
% Sekarang kita ambil sebuah titik umum pada sumbu-y.
>P &= [0,u]

                                [0, u]

% Hitung jaraknya ke g1.
>d1 &= distance(P,projectToLine(P,g1)); $d1
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-139.png
% // latex: \sqrt{\left(\frac{a^2\,u}{a^2+1}-u\right)^2+\frac{a^2\,u^2}{\left(a  ^2+1\right)^2}}
% Hitung jaraknya ke g.
>d &= distance(P,projectToLine(P,g)); $d
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-140.png
% // latex: \sqrt{\left(\frac{u+2}{5}-u\right)^2+\frac{\left(2\,u-1\right)^2}{  25}}
% Dan carilah pusat kedua lingkaran, yang jaraknya sama.
>sol &= solve(d1^2=d^2,u); $sol
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-141.png
% // latex: \left[ u=\frac{-\sqrt{5}\,\sqrt{a^2+1}+2\,a^2+2}{4\,a^2-1} , u=  \frac{\sqrt{5}\,\sqrt{a^2+1}+2\,a^2+2}{4\,a^2-1} \right] 
% Ada dua solusi.
% 
% Kita evaluasi solusi simbolik tersebut, dan temukan kedua pusat, dan kedua jarak.
>u := sol()
[0.333333,  1]
>dd := d()
[0.149071,  0.447214]
% Gambar lingkaran-lingkaran ke dalam gambar.
>color(red);
>plotCircle(circleWithCenter([0,u[1]],dd[1]),"");
>plotCircle(circleWithCenter([0,u[2]],dd[2]),"");
>insimg;
 %image% 6. Visualisasi dan Perhitungan Geometri dengan EMT-142.png
% Hasil yang diharapkan: u = [0.333333, 1]; jari-jari dd = [0.149071, 0.447214].
% 
% ** Gambar dengan Povray
% 
% Selanjutnya kita gambar semuanya dengan Povray. Perhatikan bahwa Anda dapat mengubah perintah
% apa pun dalam rangkaian perintah Povray berikut, dan menjalankan ulang semua perintah dengan
% Shift-Return.
% 
% Pertama kita muat fungsi-fungsi povray.
>load povray;
>defaultpovray="C:\Program Files\POV-Ray\v3.7\bin\pvengine.exe"
C:\Program Files\POV-Ray\v3.7\bin\pvengine.exe
