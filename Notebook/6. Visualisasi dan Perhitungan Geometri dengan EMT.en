% Hasil yang diharapkan (bandingkan keluaran asli): jarak FMIPA-Solo = 53.8945 km, heading 65Â°20'26.60'';
% luas segitiga FMIPA-Solo-Semarang = 2123.64 km^2; jarak Tugu-Monas mendekati 429.66 km dengan
% heading 294Â°17'2.85''; setelah 10 langkah dengan heading tetap, posisi meleset 1.529 km.
% 
% * Latihan (Soal Akhir)
% 
% ** Latihan 1: Segi-n beraturan jika diketahui pusat O, n, dan jari-jari lingkaran luar r
% 
% Uraian materi: segi-n beraturan mempunyai n titik sudut pada lingkaran luar berpusat O, dengan
% sudut pusat yang menghadap setiap sisi sebesar 360/n derajat (2pi/n radian). Titik sudut ke-k:
% latex: V_k = O + r(\cos(\theta_0 + 2\pi k/n),\ \sin(\theta_0 + 2\pi k/n)),\quad k=0,\dots,n-1.
% Sama dengan petunjuk soal: titik sudut adalah perpotongan lingkaran luar dengan garis-garis
% yang melalui pusat dan saling membentuk sudut kelipatan 360/n. Untuk n ganjil, satu titik sudut
% di atas (theta0 = 90Â°); untuk n genap, dua titik sudut di kiri dan kanan pusat (theta0 = 0Â°).
% Panjang sisi = 2 r sin(pi/n).
>function titikSegiN (O,n,r) ...
$  if mod(n,2)==1 then t0=pi/2; else t0=0; endif;
$  t=t0+2*pi*(0:n-1)/n;
$  return (O[1]+r*cos(t))_(O[2]+r*sin(t));
$endfunction
>function gambarSegiN (O,n,r) ...
$  V=titikSegiN(O,n,r);
$  setPlotRange(O[1]-1.5*r,O[1]+1.5*r,O[2]-1.5*r,O[2]+1.5*r);
$  aspect(1);
$  plotCircle(circleWithCenter(O,r),"");
$  plotPoint(O,"O");
$  for i=1 to n
$    j=i+1; if j>n then j=1; endif;
$    plotPoint(V[,i]');
$    plotSegment(V[,i]',V[,j]',"");
$    plotSegment(O,V[,i]',"");
$  end;
$endfunction
